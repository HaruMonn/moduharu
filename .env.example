# =================== 오늘의 기록 백엔드 환경설정 (예시) ===================
# 이 파일을 복사해서 .env 로 만들고 실제 값을 넣으세요.
# 실제 .env 파일은 절대 GitHub에 커밋하지 마세요 (.gitignore에 등록됨).

# jsonbin.io 마스터 키 (절대 프론트에 노출 금지)
JSONBIN_MASTER_KEY=여기에_마스터_키_입력

# jsonbin.io 빈 ID
JSONBIN_REQUESTS_BIN=여기에_의견_빈_ID
JSONBIN_RANKINGS_BIN=여기에_랭킹_빈_ID
JSONBIN_USERS_BIN=여기에_사용자_빈_ID

# 관리자 토큰 (의견 삭제 등 관리자 기능에 사용)
ADMIN_TOKEN=여기에_관리자_토큰_입력

# 백엔드 포트 (로컬: 3001, Render 등 클라우드: 자동 PORT 사용)
PORT=3001
